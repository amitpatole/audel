    given-names: Amit
    email: amit.patole@gmail.com
repository-code: "https://github.com/amitpatole/audel"
url: "https://amitpatole.github.io/audel/"
license: MIT
version: 0.1.0
date-released: "2026-06-22"
keywords:
  - audio quality control
  - loudness
  - speech recognition
  - AI agents
  - verification
